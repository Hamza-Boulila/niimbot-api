# Copy to .env and adjust. Every setting can also be an environment variable.

# --- Printer ---
NIIMBOT_MODEL=b1                 # b1 | b18 | b21 | d11 | d110
NIIMBOT_CONN=ble                 # usb | ble | bluetooth (Linux RFCOMM)
NIIMBOT_ADDR=B1-XXXXXXXX       # BLE name/prefix/address, serial port, or MAC; empty = auto
NIIMBOT_DENSITY=3                # 1-5 default print darkness

# --- Defaults for requests that don't specify them ---
# NIIMBOT_LABEL_WIDTH_MM=50      # across the print head
# NIIMBOT_LABEL_HEIGHT_MM=30     # along the feed
NIIMBOT_DITHER=true              # false = sharp threshold (text, barcodes, QR)

# --- Server ---
NIIMBOT_HOST=127.0.0.1           # 0.0.0.0 to accept requests from other devices on your network
NIIMBOT_PORT=8000
# NIIMBOT_API_KEY=change-me      # required as X-API-Key / Bearer token when set
# Websites allowed to call the API from a browser (localhost is always allowed), or *
# NIIMBOT_CORS_ORIGINS=https://myapp.com,https://staging.myapp.com
NIIMBOT_ALLOW_IMAGE_URL=true     # allow /v1/print/url to download images
NIIMBOT_MAX_UPLOAD_MB=20
NIIMBOT_KEEPALIVE_SECONDS=60     # keep the printer connected between jobs (0 = never)
NIIMBOT_JOB_HISTORY=200
